<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:SmartUnrealLocalization.Localization"
             x:Class="SmartUnrealLocalization.Controls.DialogTitleBar"
             x:Name="Root"
             Height="32">
    <Border Background="{DynamicResource ChromeBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnDragPressed">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="{Binding #Root.Title}"
                       VerticalAlignment="Center"
                       Margin="12,0"
                       Foreground="{DynamicResource TextPrimary}"
                       FontSize="12"
                       FontWeight="SemiBold"/>

            <Button Grid.Column="1"
                    Classes="chromeButton closeButton"
                    Click="OnClose"
                    ToolTip.Tip="{Binding [common.close], Source={x:Static loc:Loc.Instance}}">
                <Path Width="10" Height="10"
                      Stretch="Uniform"
                      Stroke="{DynamicResource TextPrimary}"
                      StrokeThickness="1"
                      Data="M0,0 L10,10 M10,0 L0,10"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
